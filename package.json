{
  "name": "myanydo",
  "productName": "MyAnydo",
  "version": "1.1.1",
  "description": "Local-first todo app: My Day, This Week, All Tasks & macOS Calendar",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "test:sort": "node scripts/test-sort.mjs",
    "icon": "bash scripts/make-icon.sh",
    "dist": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/hanken-grotesk": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dayjs": "^1.11.13",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.myanydo.desktop",
    "productName": "MyAnydo",
    "afterPack": "scripts/adhoc-sign.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "icon": "build/icon.icns",
      "identity": null
    }
  }
}
